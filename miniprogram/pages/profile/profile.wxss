/* 「我的」页样式（ADR 0006）：沿用全局主题变量，菜单行风格与全局卡片一致 */

.user-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 无头像时的兜底：主题浅底 + emoji */
.avatar-fallback {
  background: var(--brand-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.user-text {
  flex: 1;
}

.group-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 8rpx;
  border-bottom: 1rpx solid rgba(31, 35, 41, 0.06);
}

/* 最后一行不画分割线，避免贴卡片圆角 */
.menu-row:last-child {
  border-bottom: none;
}

.icon {
  font-size: 36rpx;
}

.label {
  flex: 1;
  font-size: 30rpx;
}

.chev {
  color: var(--text-secondary);
  font-size: 32rpx;
}
