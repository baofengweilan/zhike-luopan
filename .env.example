# ==== 后端 ====
DATABASE_URL=mysql+pymysql://zhike:zhike@localhost:3306/zhike_luopan?charset=utf8mb4
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# ==== 微信小程序 ====
WX_APPID=your-wx-appid
WX_SECRET=your-wx-secret
WX_SUBSCRIBE_TEMPLATE_LESSON=your-template-id
WX_SUBSCRIBE_TEMPLATE_HOLIDAY=your-template-id

# ==== AI（任意 OpenAI 兼容网关，详见 docs/adr/0007） ====
# 主力：腾讯云开发 CloudBase 混元 hy3（小程序成长计划赠送额度）
#   Base URL / API Key 从 CloudBase 控制台"AI 设置"页获取，模型填 hy3
# 备选：移动云 MoMA（移动云杯赛方平台，Key 批下来后换回以下三行即可）
#   AI_BASE_URL=https://moma.cmecloud.cn/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ==== 文件与安全 ====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
SENSITIVE_WORDS_FILE=./config/sensitive_words.txt

# ==== 开发便利 ====
# 开发时若无微信密钥，置 true 走 mock 登录（仅限本地开发！）
WX_MOCK_LOGIN=false
# 置 DEBUG 可看到每次请求与课表生成每步决策的详细日志
LOG_LEVEL=INFO
