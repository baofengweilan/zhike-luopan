page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.chat {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.bubble-row {
  display: flex;
  margin-bottom: 20rpx;
}

.bubble-row.me {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  background: var(--card);
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  line-height: 1.5;
  white-space: pre-wrap;
}

.bubble.me {
  background: var(--brand);
  color: #fff;
}

.bubble.link {
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 24rpx 16rpx;
}

.chip {
  background: var(--card);
  color: var(--brand);
  font-size: 24rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--brand-light);
}

.input-bar {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: var(--card);
}

.input {
  flex: 1;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 18rpx 24rpx;
}

.send-btn {
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
  padding: 0 36rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}

/* ==== ADR 0009：📎 发文件按钮 + 文件导入确认卡片 ==== */
.attach-btn {
  font-size: 40rpx;
  padding: 0 16rpx;
  line-height: 72rpx;
}

.import-card {
  max-width: 86%;
  background: #f0f5ff;
  border: 2rpx solid var(--brand);
}
.ic-text {
  font-size: 28rpx;
  margin-bottom: 12rpx;
}
.ic-list {
  max-height: 420rpx;
  overflow-y: auto;
  background: #fff;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}
.ic-course {
  padding: 8rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}
.ic-name {
  font-size: 28rpx;
  font-weight: 600;
}
.ic-meta {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 4rpx;
}
.ic-warn {
  font-size: 22rpx;
  color: #d46b08;
  margin-top: 8rpx;
}
.ic-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.ic-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid #dcdfe6;
}
.ic-btn.primary {
  background: var(--brand);
  color: #fff;
  border-color: var(--brand);
}
