.tpl {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--bg);
}

.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.info {
  flex: 1;
}

.course {
  font-weight: 500;
}

.link.danger {
  color: var(--danger);
  font-size: 26rpx;
  padding: 0 12rpx;
}

.form {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}
