.toolbar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--card);
  border-radius: 12rpx;
  font-size: 36rpx;
}

.date-btn {
  flex: 1;
  background: var(--card);
  border-radius: 12rpx;
  padding: 14rpx 24rpx;
  text-align: center;
  font-weight: 600;
}

.seg {
  display: flex;
  background: var(--card);
  border-radius: 12rpx;
  overflow: hidden;
}

.seg-item {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.seg-item.on {
  background: var(--brand);
  color: #fff;
}

.lesson {
  display: flex;
  align-items: center;
  gap: 24rpx;
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin: 20rpx 24rpx;
}

.period {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.lesson-main {
  flex: 1;
}

.course {
  font-size: 32rpx;
  font-weight: 600;
}

.status {
  font-size: 22rpx;
  color: #d46b08;
  background: #fff3e6;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  font-weight: 400;
}

.week-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}

.week-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.day-col {
  width: 300rpx;
  background: var(--card);
  border-radius: 16rpx;
  padding: 16rpx;
  display: inline-block;
  vertical-align: top;
  white-space: normal;
}

.day-col.today {
  border: 2rpx solid var(--brand);
}

.day-head {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  color: var(--text);
}

.mini {
  background: var(--bg);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  margin-bottom: 10rpx;
}

.mini-course {
  font-size: 24rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mini-time {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.mini-empty {
  text-align: center;
}

.regen {
  text-align: center;
  margin-top: 24rpx;
  color: var(--brand);
  font-size: 26rpx;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.detail {
  width: 600rpx;
  position: relative;
  overflow: hidden;
}

.detail-color {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
}

.detail-row {
  margin: 16rpx 0;
}

/* ==== 阶段五：弹层多视图样式 ==== */
.actions-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.action {
  flex: 1;
  text-align: center;
  background: var(--brand-light);
  color: var(--brand);
  border-radius: 12rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
}

.popup-form {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.textarea {
  height: 140rpx;
  padding-top: 18rpx;
}

.conflict-box {
  background: #fff3e6;
  border-radius: 12rpx;
  padding: 20rpx;
}

.conflict-title {
  color: #d46b08;
  font-weight: 600;
  font-size: 26rpx;
}

.conflict-item {
  color: #d46b08;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.force-toggle {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--text);
}

.back-link {
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
  padding: 8rpx;
}

.feedback-result {
  color: var(--brand);
  font-weight: 600;
  margin: 16rpx 0;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--bg);
}

.h-summary {
  flex: 1;
  font-size: 26rpx;
}

.link.danger {
  color: var(--danger);
  font-size: 26rpx;
}

/* 阶段四：详情弹层封面 */
.detail-head {
  display: flex;
  gap: 20rpx;
}

.detail-cover {
  width: 120rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.detail-head-text {
  flex: 1;
}

/* A21：调课建议 */
.sug-box {
  margin-top: 14rpx;
  background: var(--brand-light);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.sug-title {
  color: var(--brand);
  font-weight: 600;
  font-size: 26rpx;
}

.sug-item {
  color: var(--brand);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.regen-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 24rpx;
}

/* ---- ADR 0006 首屏化新增 ---- */

/* 正在上的课：品牌色描边 + 轻投影，让"现在上什么课"一眼可见 */
.lesson.current {
  border: 2rpx solid var(--brand);
  box-shadow: 0 4rpx 16rpx rgba(47, 111, 237, 0.18);
}

/* "下一节"标签：与已调整/已取消的警示色区分，用品牌色 */
.status.next {
  color: var(--brand);
}

/* 无学期引导卡：居中、给主动作按钮 */
.guide {
  text-align: center;
  padding: 72rpx 40rpx;
  margin-top: 48rpx;
}

.guide-title {
  font-size: 38rpx;
  font-weight: 700;
}

/* ==== ADR 0009：导入确认卡片 ==== */
.import-list {
  max-height: 420rpx;
  overflow-y: auto;
  margin: 16rpx 0;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}
.import-row {
  font-size: 24rpx;
  line-height: 1.7;
  color: #333;
}
.import-clear {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  margin: 12rpx 0;
}
.import-checkbox {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #bbb;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.import-checkbox.on {
  background: #2f6fed;
  border-color: #2f6fed;
}
.action.primary {
  color: #fff;
  background: #2f6fed;
}

/* ==== 周网格（ADR 0009 §4 完美校园风格）==== */

.week-badge {
  background: var(--brand);
  color: #fff;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
  white-space: nowrap;
}

.grid-scroll {
  height: calc(100vh - 220rpx);
  padding: 0 16rpx;
}

.grid-head {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 2;
  background: var(--bg, #f6f7fb);
}

.grid-corner {
  width: 96rpx;
  flex-shrink: 0;
}

.grid-day {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx 12rpx 0 0;
  color: var(--text-secondary);
}

.grid-day.today {
  background: var(--brand);
  color: #fff;
}

.gd-name {
  font-size: 24rpx;
  font-weight: 600;
}

.gd-date {
  font-size: 20rpx;
  opacity: 0.8;
}

.grid-body {
  display: flex;
  position: relative;
  background: var(--card);
  border-radius: 0 0 16rpx 16rpx;
  overflow: hidden;
}

/* 时间轴列：行高必须与 schedule.ts 的 GRID_ROW_H（108rpx）一致 */
.grid-times {
  width: 96rpx;
  flex-shrink: 0;
}

.grid-time-cell {
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid var(--line, #e8eaf0);
}

.gt-no {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.gt-time {
  font-size: 18rpx;
  color: var(--text-secondary);
  opacity: 0.7;
}

.grid-cols {
  flex: 1;
  display: flex;
  position: relative;
}

.grid-col {
  flex: 1;
  border-left: 1rpx solid var(--line, #e8eaf0);
  /* 横向网格线：每 108rpx 一条（同 GRID_ROW_H） */
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 107rpx,
    var(--line, #e8eaf0) 107rpx,
    var(--line, #e8eaf0) 108rpx
  );
}

.grid-col.today {
  background-color: rgba(47, 111, 237, 0.05);
}

.grid-card {
  position: absolute;
  border-radius: 12rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  color: #fff;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.grid-card.cancelled {
  opacity: 0.45;
  text-decoration: line-through;
}

.gc-name {
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.25;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.gc-loc {
  font-size: 18rpx;
  opacity: 0.85;
  margin-top: 4rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.grid-empty {
  text-align: center;
  padding: 40rpx 0;
}
