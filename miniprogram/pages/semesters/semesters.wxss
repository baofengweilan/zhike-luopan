.row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.link {
  color: var(--brand);
  font-size: 26rpx;
}

.link.danger {
  color: var(--danger);
}

.form {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.hint {
  margin-top: -8rpx;
}

.semester.active {
  border: 2rpx solid var(--brand);
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.badge {
  background: var(--brand-light);
  color: var(--brand);
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.actions {
  display: flex;
  gap: 40rpx;
  margin-top: 16rpx;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
}
