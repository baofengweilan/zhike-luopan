.row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.row-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.link {
  color: var(--brand);
  font-size: 26rpx;
}

.link.danger {
  color: var(--danger);
}

.form {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.empty {
  text-align: center;
  margin-top: 120rpx;
}
