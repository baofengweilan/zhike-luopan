.timeline {
  margin-top: 24rpx;
  position: relative;
  padding-left: 30rpx;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 20rpx;
  bottom: 20rpx;
  width: 4rpx;
  background: var(--brand-light);
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  position: relative;
}

.node {
  position: absolute;
  left: -27rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--brand);
}

.row.break .node {
  background: var(--text-secondary);
}

.label {
  width: 160rpx;
  font-weight: 600;
}

.row.break .label {
  color: var(--text-secondary);
  font-weight: 400;
}

.time {
  flex: 1;
  color: var(--text-secondary);
}

.link.danger {
  color: var(--danger);
  font-size: 26rpx;
  padding: 0 12rpx;
}

.form {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.time-row {
  display: flex;
  gap: 20rpx;
}

.time-row picker {
  flex: 1;
}

.break-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.check {
  font-size: 36rpx;
  color: var(--brand);
}
